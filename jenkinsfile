pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Run Selenium TestNG Automation') {
            steps {
                script {
                    catchError(
                        buildResult: 'UNSTABLE',
                        stageResult: 'FAILURE'
                    ) {
                        sh 'mvn clean test'
                    }
                }
            }
        }
    }

    post {

        always {
            echo '=========================================='
            echo '       SELENIUM TESTNG TEST RESULTS'
            echo '=========================================='

            // Publish Maven Surefire/TestNG results
            junit(
                testResults: '**/surefire-reports/*.xml',
                allowEmptyResults: true
            )

            // Archive TestNG/Surefire reports
            archiveArtifacts(
                artifacts: '**/surefire-reports/**',
                allowEmptyArchive: true
            )
        }

        success {
            echo '=========================================='
            echo ' ALL SELENIUM TEST CASES PASSED'
            echo '=========================================='
        }

        unstable {
            echo '=========================================='
            echo ' SOME SELENIUM TEST CASES FAILED'
            echo ' Remaining tests were executed.'
            echo ' Check the Jenkins Test Results for details.'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo ' JENKINS PIPELINE FAILED'
            echo '=========================================='
        }
    }
}